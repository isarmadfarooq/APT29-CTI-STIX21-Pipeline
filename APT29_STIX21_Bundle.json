    {
      "type": "malware",
      "spec_version": "2.1",
      "id": "malware--teardrop-apt29-001",
      "created": "2024-03-15T08:00:00.000Z",
      "modified": "2024-03-15T08:00:00.000Z",
      "name": "TEARDROP",
      "description": "TEARDROP is a memory-only dropper that reads a fake JPEG image file (favicon.jpg) to extract and decode an embedded payload. Used as second-stage malware to deliver a customized Cobalt Strike beacon. Does not write artifacts to disk, making forensic detection difficult.",
      "malware_types": [
        "dropper"
      ],
      "is_family": false,
      "aliases": [
        "TEARDROP"
      ],
      "first_seen": "2023-11-01T00:00:00.000Z",
