      "id": "malware--sunburst-apt29-001",
      "created": "2024-03-15T08:00:00.000Z",
      "modified": "2024-03-15T08:00:00.000Z",
      "name": "SUNBURST",
      "description": "SUNBURST is a trojanized update to the SolarWinds Orion IT management software used in the 2020 supply chain attack. Although not directly used in Operation PHANTOM BEAR, infrastructure overlaps were identified linking to the 2020 campaign.",
      "malware_types": [
        "backdoor",
