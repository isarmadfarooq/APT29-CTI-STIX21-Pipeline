    {
      "type": "malware",
      "spec_version": "2.1",
      "id": "malware--wineloader-apt29-001",
      "created": "2024-03-15T08:00:00.000Z",
      "modified": "2024-03-15T08:00:00.000Z",
      "name": "WINELOADER",
      "description": "WINELOADER is a newly identified modular backdoor attributed exclusively to APT29. Delivered via ZIP archive in spear-phishing emails, it injects shellcode into sqlwriter.exe using process hollowing. C2 communication uses HTTPS over port 443 with RC4 encryption and base64 encoding. Achieves persistence via Windows Registry Run keys.",
      "malware_types": [
        "backdoor",
        "dropper"
      ],
      "is_family": false,
      "aliases": [
        "WINELOADER"
      ],
      "first_seen": "2023-10-14T00:00:00.000Z",
      "last_seen": "2024-02-28T00:00:00.000Z",
      "architecture_execution_envs": [
        "x86-64"
      ],
      "implementation_languages": [
        "c"
      ],
      "capabilities": [
        "communicates-with-c2",
        "persists-after-system-reboot",
        "steals-credentials",
        "evades-av"
      ],
      "operating_system_refs": [],
      "created_by_ref": "identity--a1b2c3d4-e5f6-7890-abcd-ef1234567890",
