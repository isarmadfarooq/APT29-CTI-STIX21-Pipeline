    {
      "type": "campaign",
      "spec_version": "2.1",
      "id": "campaign--phantom-bear-2023",
      "created": "2024-03-15T08:00:00.000Z",
      "modified": "2024-03-15T08:00:00.000Z",
      "name": "Operation PHANTOM BEAR",
      "description": "A targeted espionage campaign conducted by APT29 between October 2023 and February 2024. The campaign targeted European diplomatic missions using spear-phishing emails with wine-tasting event lures, deploying WINELOADER and TEARDROP malware to achieve persistent access and data exfiltration.",
      "aliases": [
        "PHANTOM BEAR"
      ],
      "first_seen": "2023-10-01T00:00:00.000Z",
      "last_seen": "2024-02-28T00:00:00.000Z",
      "objective": "Espionage and intelligence collection from European diplomatic entities",
